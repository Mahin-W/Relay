{
  "name": "relay-bot",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --env-file=.env src/tests/run-tests-parallel.js",
    "test:fast": "node --env-file=.env src/tests/run-tests-parallel.js --skip-llm",
    "test:llm": "node --env-file=.env src/tests/run-tests-parallel.js --llm-only",
    "test:seq": "node --env-file=.env src/tests/run-tests.js",
    "test:unit": "node --env-file=.env --test src/tests/unit/availabilityParser.test.js src/tests/unit/shiftMatcher.test.js src/tests/unit/scheduleGenerator.test.js src/tests/unit/botAdmins.test.js src/tests/unit/tradeFlow.test.js src/tests/unit/laborCost.test.js src/tests/unit/budgetAlert.test.js src/tests/unit/shiftLog.test.js",
    "test:unit:groq": "node --env-file=.env --test src/tests/unit/parseMessage.test.js",
    "test:integration": "node --env-file=.env --test src/tests/integration/coverageFlow.test.js src/tests/integration/setupFlow.test.js src/tests/integration/botAdminFlow.test.js src/tests/integration/scheduleFlow.test.js",
    "test:e2e": "node --env-file=.env --test src/tests/e2e/fullWeekFlow.test.js",
    "test-parse": "node src/test-parse.js",
    "watch": "node scripts/auto-commit.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "chokidar": "^5.0.0",
    "wrangler": "^4.105.0"
  }
}
