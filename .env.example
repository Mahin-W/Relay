TELEGRAM_BOT_TOKEN=get_from_botfather
CEREBRAS_API_KEY=get_from_cloud_cerebras_ai
GROQ_API_KEY=get_from_console_groq_com
SUPABASE_URL=get_from_supabase_project_settings
SUPABASE_ANON_KEY=get_from_supabase_project_settings
# REQUIRED in production once migration 008 (RLS lockdown) has been run.
# In dev the server falls back to the anon key, but a real production deploy
# will return zero rows for every query without this set.
SUPABASE_SERVICE_ROLE_KEY=get_from_supabase_project_settings
# REQUIRED. At least 32 characters. The server refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=generate_a_long_random_secret
# Account-based dashboard login (Supabase Auth). Required for the account-centric
# signup/login flow; without it only legacy phone-OTP sessions work.
# Supabase project → Settings → API → JWT Settings → "JWT Secret".
SUPABASE_JWT_SECRET=get_from_supabase_jwt_settings
# Bot username (no @) — used to build Telegram deep links, including the account
# linking code (https://t.me/<BOT_USERNAME>?start=link_<code>).
BOT_USERNAME=your_bot_username
# Login confirmation code (2FA) email fallback, used when an account has no
# Telegram linked. Optional — if unset, 2FA only sends via Telegram and accounts
# without Telegram skip the code (fail-open) rather than being locked out.
# Get a key at resend.com; verify a sending domain for RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=Relay <login@yourdomain.com>
NODE_ENV=development
ANTHROPIC_API_KEY=get_from_console_anthropic_com
# Optional — server-side proxy target for the public landing-page waitlist form.
# When unset, /api/waitlist accepts the email and logs it instead of forwarding.
WAITLIST_GAS_URL=
# Optional — IANA timezone for all cron jobs (shift reminders, briefings, no-show checks, etc.).
# When unset, crons run in UTC. Set to the restaurant's local timezone, e.g.:
#   CRON_TZ=America/New_York
#   CRON_TZ=America/Chicago
#   CRON_TZ=America/Los_Angeles
# node-cron validates the value at startup and throws if it's invalid.
CRON_TZ=

# ── Payments / payroll (Epic 1/2) ────────────────────────────────────────────
# Payroll rail. Check is the single rail for W-2 + 1099 (tax filing + owner→
# employee direct deposit). Leave unset until Epic 1/2 are wired — the bot runs
# fine without it; only money operations require it.
#   PAYROLL_PROVIDER=check    (primary)
#   PAYROLL_PROVIDER=stripe   (1099/contractor pay only — optional lane)
PAYROLL_PROVIDER=
CHECK_API_KEY=
CHECK_WEBHOOK_SECRET=
# Optional Stripe lane (1099 contractors only — not needed for W-2 payroll).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
